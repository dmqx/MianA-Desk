#include <winver.h>

1 ICON "@package_icon@"
101 RCDATA "@package_payload@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MianA Desk single-file package"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "MianA Desk"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "MianA-Desk-v@PROJECT_VERSION@.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
